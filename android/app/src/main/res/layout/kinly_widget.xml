<?xml version="1.0" encoding="utf-8"?>
<!-- Intestazione (logo + titolo + le 3 scorciatoie) SEMPRE fissa in alto:
     solo il blocco delle persone sotto, in mezzo allo spazio che resta, si
     centra verticalmente se il widget viene ridimensionato più alto del
     necessario (vedi il FrameLayout con layout_weight più sotto). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/kinly_widget_background">

    <!-- Riga fissa in alto: icona + titolo a sinistra, le 3 scorciatoie
         rapide a destra, come nel mockup del sito. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/widget_logo" />

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kinly"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textColor="#4A63E7" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/widget_btn_sos"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_action_circle_sos"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="🆘"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_btn_help"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_action_circle_help"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="✋"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_btn_walk"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_action_circle_walk"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="🚶"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Nome della cerchia mostrata, con frecce per passare alla precedente/
         successiva se l'utente ne ha più di una: le frecce mandano un
         broadcast diretto al widget (vedi KinlyWidgetProvider.onReceive),
         che aggiorna e ridisegna subito senza aprire l'app. Nascosta del
         tutto se l'utente non ha ancora nessuna cerchia. -->
    <LinearLayout
        android:id="@+id/widget_circle_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_circle_prev"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="‹"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textColor="#8A90A6" />

        <TextView
            android:id="@+id/widget_circle_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:textColor="#4A63E7" />

        <TextView
            android:id="@+id/widget_circle_next"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="›"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textColor="#8A90A6" />
    </LinearLayout>

    <!-- Anteprima per chi non ha Kinly+: il widget è una funzione a
         pagamento (vedi HomeWidgetService), quindi niente nome o posizione
         reale finisce nei dati letti qui, solo un invito a sbloccarla.
         Toccarla apre l'app dritta sulla pagina di Kinly+ (kinly://paywall),
         non un'azione diretta. -->
    <LinearLayout
        android:id="@+id/widget_locked_group"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="🔒"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/widget_locked_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:textStyle="bold"
            android:textSize="12.5sp"
            android:textColor="#222533" />

        <TextView
            android:id="@+id/widget_locked_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="11sp"
            android:textColor="#8A90A6" />
    </LinearLayout>

    <!-- Occupa tutto lo spazio verticale che resta sotto l'intestazione: le
         righe delle persone dentro si centrano lì, invece di restare
         incollate in alto con un vuoto enorme sotto quando il widget è
         ridimensionato più alto del contenuto (es. una sola persona). -->
    <FrameLayout
        android:id="@+id/widget_content_frame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/widget_rows_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:orientation="vertical">

            <!-- Ogni riga è un "avatar" (pallino colorato con la sagoma di
                 una persona sopra) + un contenuto che può essere il testo
                 vero (nome, posizione, orario) oppure, quando nessuno
                 condivide ancora, una barra grigia astratta: stessa
                 struttura visiva sempre, cambia solo cosa si vede dentro
                 (vedi KinlyWidgetProvider). -->
            <LinearLayout
                android:id="@+id/widget_row1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <FrameLayout android:layout_width="28dp" android:layout_height="28dp" android:layout_marginEnd="10dp">
                    <ImageView
                        android:id="@+id/widget_dot1"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/widget_dot" />
                    <ImageView
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:layout_gravity="center"
                        android:src="@drawable/widget_person_icon" />
                </FrameLayout>

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <LinearLayout
                        android:id="@+id/widget_text_group1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/widget_name1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="13.5sp"
                            android:textStyle="bold"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:textColor="#222533" />

                        <TextView
                            android:id="@+id/widget_sub1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:textSize="11sp"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:textColor="#8A90A6" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/widget_bars_group1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/widget_bar1"
                            android:layout_width="120dp"
                            android:layout_height="9dp"
                            android:src="@drawable/widget_bar" />

                        <ImageView
                            android:id="@+id/widget_bar1b"
                            android:layout_width="72dp"
                            android:layout_height="7dp"
                            android:layout_marginTop="6dp"
                            android:src="@drawable/widget_bar" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_divider2"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:background="#EDEFF6" />

            <LinearLayout
                android:id="@+id/widget_row2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <FrameLayout android:layout_width="28dp" android:layout_height="28dp" android:layout_marginEnd="10dp">
                    <ImageView
                        android:id="@+id/widget_dot2"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/widget_dot" />
                    <ImageView
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:layout_gravity="center"
                        android:src="@drawable/widget_person_icon" />
                </FrameLayout>

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <LinearLayout
                        android:id="@+id/widget_text_group2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/widget_name2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="13.5sp"
                            android:textStyle="bold"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:textColor="#222533" />

                        <TextView
                            android:id="@+id/widget_sub2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:textSize="11sp"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:textColor="#8A90A6" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/widget_bars_group2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/widget_bar2"
                            android:layout_width="120dp"
                            android:layout_height="9dp"
                            android:src="@drawable/widget_bar" />

                        <ImageView
                            android:id="@+id/widget_bar2b"
                            android:layout_width="72dp"
                            android:layout_height="7dp"
                            android:layout_marginTop="6dp"
                            android:src="@drawable/widget_bar" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_divider3"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:background="#EDEFF6" />

            <LinearLayout
                android:id="@+id/widget_row3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <FrameLayout android:layout_width="28dp" android:layout_height="28dp" android:layout_marginEnd="10dp">
                    <ImageView
                        android:id="@+id/widget_dot3"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/widget_dot" />
                    <ImageView
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:layout_gravity="center"
                        android:src="@drawable/widget_person_icon" />
                </FrameLayout>

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <LinearLayout
                        android:id="@+id/widget_text_group3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/widget_name3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="13.5sp"
                            android:textStyle="bold"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:textColor="#222533" />

                        <TextView
                            android:id="@+id/widget_sub3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:textSize="11sp"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:textColor="#8A90A6" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/widget_bars_group3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/widget_bar3"
                            android:layout_width="120dp"
                            android:layout_height="9dp"
                            android:src="@drawable/widget_bar" />

                        <ImageView
                            android:id="@+id/widget_bar3b"
                            android:layout_width="72dp"
                            android:layout_height="7dp"
                            android:layout_marginTop="6dp"
                            android:src="@drawable/widget_bar" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Quando condivide una sola persona, mostra lei sola più grande
             invece delle 3 righe compatte pensate per riempirsi: altrimenti,
             specie su un widget ridimensionato bello alto, restava un
             avatarino piccolo perso in un mare di spazio vuoto sopra e
             sotto (vedi KinlyWidgetProvider). -->
        <LinearLayout
            android:id="@+id/widget_solo_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:visibility="gone">

            <FrameLayout android:layout_width="64dp" android:layout_height="64dp">
                <ImageView
                    android:id="@+id/widget_solo_dot"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_dot" />
                <ImageView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="center"
                    android:src="@drawable/widget_person_icon" />
            </FrameLayout>

            <TextView
                android:id="@+id/widget_solo_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textSize="20sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#222533" />

            <TextView
                android:id="@+id/widget_solo_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="13.5sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#8A90A6" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
